{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valueplus-erp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "valueplus-erp"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Photos the delivery boy takes at handover (viewed by Admin / Manager).
  "r2_buckets": [{ "binding": "DELIVERY_PROOFS", "bucket_name": "valueplus-delivery-proofs" }],
  // D1 (SQLite) database. Phase 1 of docs/D1_MIGRATION_PLAN.md: it only holds a COPY of the master data, filled by
  // the cron (/api/cron/d1-sync); MongoDB is still the only thing the app reads and writes.
  // Schema: d1/migrations (npx wrangler d1 migrations apply valueplus-db --remote).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valueplus-db",
      "database_id": "519a8be8-7520-4a8b-861a-11a28791648f",
      "migrations_dir": "d1/migrations"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://valuplus.shineinfosolutions.in"
  },
  // Every 5 minutes (worker.ts picks the job): office-time reminder at 10:00 India time, late / break alerts,
  // automatic check-out at the shift end. Was every minute — 1,440 runs a day, each opening a database connection.
  // Only from 03:00 to 18:55 UTC = 08:30 to 00:25 India time (192 runs a day instead of 288): nothing is due at
  // night. The 10:00 reminder, the 21:00 automatic check-out and the 00:00-00:25 clean-up of days left open all
  // fall inside it (see lib/attendance-alerts.ts).
  "triggers": { "crons": ["*/5 3-18 * * *"] },
  "routes": [
    { "pattern": "valuplus.shineinfosolutions.in", "custom_domain": true }
  ],
  // AppServer: see worker.ts — kept only for the earlier deployment's namespace.
  // REALTIME: the WebSocket hub for live updates (realtime-hub.ts).
  "durable_objects": {
    "bindings": [
      { "name": "APP_SERVER", "class_name": "AppServer" },
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppServer"] },
    { "tag": "v2", "new_sqlite_classes": ["RealtimeHub"] }
  ]
}
