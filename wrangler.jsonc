{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valueplus-erp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "valueplus-erp"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Photos the delivery boy takes at handover (viewed by Admin / Manager).
  "r2_buckets": [{ "binding": "DELIVERY_PROOFS", "bucket_name": "valueplus-delivery-proofs" }],
  "vars": {
    "NEXTAUTH_URL": "https://valuplus.shineinfosolutions.in"
  },
  // Every 5 minutes (worker.ts picks the job): office-time reminder at 10:00 India time, late / break alerts,
  // automatic check-out at the shift end. Was every minute — 1,440 runs a day, each opening a database connection.
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "valuplus.shineinfosolutions.in", "custom_domain": true }
  ],
  // AppServer: see worker.ts — kept only for the earlier deployment's namespace.
  // REALTIME: the WebSocket hub for live updates (realtime-hub.ts).
  "durable_objects": {
    "bindings": [
      { "name": "APP_SERVER", "class_name": "AppServer" },
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppServer"] },
    { "tag": "v2", "new_sqlite_classes": ["RealtimeHub"] }
  ]
}
